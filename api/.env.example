NODE_ENV=development
PORT=8080
APP_URL=http://localhost:5173
DATABASE_URL=postgres://postgres:postgres@localhost:5432/workbench
ADMIN_EMAILS=you@example.com
ALLOW_SIGNUP=true
# Dev: magic links are printed to the API console when ACS is not configured
# ACS_CONNECTION_STRING=
# EMAIL_SENDER=DoNotReply@xxxx.azurecomm.net
# Local blob storage via Azurite (docker compose up)
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
STORAGE_CONTAINER=datasets
# Sandbox (Azure Container Apps session pool). Intentionally NOT emulated locally:
# without it, /api/runs returns 503 instead of running generated code on your machine.
# SANDBOX_POOL_ENDPOINT=
# AZURE_OPENAI_ENDPOINT=https://xxx.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_KEY=   # local only; in Azure the managed identity is used
DAILY_RUN_LIMIT=50
MAX_UPLOAD_MB=25
# Alpha Vantage (server-side only, never sent to the browser)
ALPHAVANTAGE_API_KEY=dummy
ALPHAVANTAGE_DAILY_DOWNLOAD_LIMIT=10
